@startuml
title Vehicle Evidence Layer | S-CORE Integration
left to right direction
skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam roundCorner 8
skinparam componentStyle rectangle
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #2D3142
skinparam rectangleFontColor #2D3142
skinparam ArrowColor #4F5D75
skinparam packageBorderColor #7A8399
skinparam packageBackgroundColor #ECECEC
skinparam componentBorderColor #2D3142
skinparam componentBackgroundColor #FFFFFF
skinparam componentFontColor #2D3142
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #BFC0C0

package "S-CORE state access" {
  component "S-CORE Module APIs" as module_api #ECECEC
  component "S-CORE Communication" as communication #ECECEC
}

package "Vehicle Evidence Layer" {
  component "Source Collectors" as collectors
  component "Evidence Processing" as processing #FFF1E9
  component "Vehicle Evidence Publisher" as publisher
  component "Collection and Audit Logging" as logging
  component "Evidence Persistence\nOptional" as persistence #FFF1E9
}

package "S-CORE operational services" {
  component "S-CORE Logging" as score_logging #ECECEC
  component "S-CORE Persistency" as score_store #ECECEC
}

module_api --> collectors : observable module state
collectors --> processing : collected records
processing --> publisher : normalized Vehicle Evidence
collectors ..> communication : when module API uses it
collectors --> logging : collection events
processing --> logging : operational events
logging --> score_logging : collection / audit logs
processing ..> persistence : only if configured
persistence ..> score_store : configured storage
@enduml
